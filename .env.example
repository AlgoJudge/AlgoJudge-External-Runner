# Every variable this Runner reads. Copy to `.env` and fill in.
# `.env` is git-ignored; the two secrets below have no default and never will.
#
# **A switch this file does not set is off.** A name ending in `Enabled` is off
# until somebody turns it on, and one ending in `Disabled` would be on until
# somebody turns it off — so what is missing from a `.env` never surprises the
# person who did not write it.

AJ_Server__BaseUrl=http://server:8080/api/v1
AJ_Runner__Name=algojudge-external-runner
# **This default is the development one**, and it is a path that exists only
# under `./x`, which mounts this checkout at `/work`. The published image has no
# `/work`, and its `nonroot` user cannot create one: an installation points this
# at a volume it owns, which is what `AlgoJudge-Ops` does.
AJ_Runner__KeyPath=/work/.probe/identity.key

# Which Runners a job may be steered to. Leave unset unless an installation
# routes work by tag; the Server matches on it and an unmatched tag is a queue
# that never drains.
# AJ_Runner__Tags=lab-a,uva

# Where a submission's source is cached on its way to the judge. There is no
# *package* cache — an external problem has none — but the participant's own
# file is fetched on every job, and it needs somewhere to live.
AJ_Cache__Path=/var/cache/algojudge-external-runner
#
# How much of it to keep. A fortieth of the sandboxing Runner's ten gigabytes,
# because that one caches problem packages and this one caches nothing but
# source text. Setting it too low costs one download per job, not a failure:
# the entry a job is reading is never evicted out from under it.
AJ_Cache__MaxBytes=268435456

# Leave AJ_Runner__ProblemTypes unset to declare whatever the integration below
# serves. Set it only to narrow or widen that deliberately.
# AJ_Runner__ProblemTypes=uva@1

# Which judging system this process forwards to. `uva` is the only one built,
# and one process serves one judge: a second is a second deployment.
AJ_External__Judge=uva

# The robot account submissions are made under. **Secrets.**
AJ_External__Username=
AJ_External__Password=

# The archive's numeric id for that account. Left unset it is resolved from the
# username on the first submission, which costs one request and is the normal
# case; set it to skip the lookup.
# AJ_External__UserId=

# Where the judge is reached. `BaseUrl` is where submissions are posted and
# `ApiBaseUrl` is where answers are read; for UVa those are two services.
AJ_External__BaseUrl=https://onlinejudge.org/
AJ_External__ApiBaseUrl=https://uhunt.onlinejudge.org/

# Never below 20: a judging system may publish no rate limit at all, as
# onlinejudge.org does not, so this one is not lowered. The Runner refuses to
# start if it is.
AJ_External__PollMinSeconds=20
AJ_External__PollMaxSeconds=60
# How long the oldest outstanding submission may wait before the interval backs
# off from the floor to the ceiling: a verdict that has not come in two minutes
# is unlikely to come in the next twenty seconds either.
AJ_External__PollEscalateAfterSeconds=120
AJ_External__SubmitMinIntervalSeconds=5
AJ_External__PendingTimeoutSeconds=900
AJ_External__MaxPending=20

# **The archive's live stream, which wakes this Runner instead of it asking.**
# uHunt holds `/api/poll/{id}` open for up to a minute and answers the moment
# anything happens anywhere; what arrives is read for one thing only — whether
# this account appears — and never for a verdict, because the stream is global,
# keeps its last hundred events, and drops the rest.
#
# **Turning it on also flattens the net above to its ceiling**: one request a
# minute instead of three, on the promise that the stream is what makes a
# verdict prompt. Measured against onlinejudge.org on 2026-09-08, a verdict came
# back in 25 s either way — the archive's own judging is what that time is, and
# what the stream buys is the requests.
#
# **So do not turn it on where a long-held request cannot survive.** Behind a
# proxy that cuts them the stream never fires, the flat net is all that is left,
# and a verdict waits a minute rather than twenty seconds.
# AJ_External__LongPollEnabled=false

# Must exceed AJ_External__PendingTimeoutSeconds, or the Server reclaims a job
# while this Runner is still waiting on the judge and the next Runner submits
# again.
AJ_Lease__RequestSeconds=1200

# How long the Server may hold a `claim` open while the queue is empty, in
# seconds — the same setting, and the same name, as the sandboxing Runner.
#
# **The ceiling is not the Server but whatever sits between.** A held claim
# sends nothing, and an intermediary that measures silence cuts it: an Azure
# Application Gateway at 20 s, a stock nginx or an AWS ALB at 60 s, Cloudflare
# at 125 s. Twenty-five clears all but the first. `0` asks for no wait and
# falls back to asking again on an interval.
#
# **The Server holds a claim for at most 300 s, and more than that is refused at
# start-up rather than clamped.** Asking for more is worse than being ignored:
# this Runner tells a held claim from an immediate answer by how long it took,
# so one asking for 900 would read the Server's 300 as no wait at all and sleep
# its backoff after every claim. It is also refused when it does not leave room
# for a lease renewal — the claim and the judge's own poll are one cycle, and a
# lease is renewed once per cycle.
AJ_Poll__WaitSeconds=25

# **The floor and ceiling of the wait between asks of our own Server**, after
# one has failed or come back empty without having been held. The wait doubles
# from the floor to the ceiling and resets on the first answer.
#
# Not the pair below it. `AJ_External__PollMin/MaxSeconds` pace the asks of
# somebody else's judging system, which is somebody else's service and is
# floored far higher. These two are the same two keys, under the same names,
# that the sandboxing Runner reads — an operator running both should not have to
# learn two vocabularies for one idea.
#
# **A held claim makes the floor rarely matter**: where `AJ_Poll__WaitSeconds`
# is not zero the wait *is* the interval, and this pair is what is left for the
# failures.
AJ_Poll__MinSeconds=1
AJ_Poll__MaxSeconds=30
