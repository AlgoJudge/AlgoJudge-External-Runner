# Every variable this Runner reads. Copy to `.env` and fill in.
# `.env` is git-ignored; the two secrets below have no default and never will.

AJ_Server__BaseUrl=http://server:8080/api/v1
AJ_Runner__Name=algojudge-runner-uva
AJ_Runner__ProblemTypes=uva@1
AJ_Runner__KeyPath=/work/.probe/identity.key

# The robot account submissions are made under. **Secrets.**
AJ_Uva__Username=
AJ_Uva__Password=

AJ_Uva__BaseUrl=https://onlinejudge.org/
AJ_Uva__UhuntBaseUrl=https://uhunt.onlinejudge.org/

# Never below 20: onlinejudge.org publishes no rate limit, so this one is not
# lowered. The Runner refuses to start if it is.
AJ_Uva__PollMinSeconds=20
AJ_Uva__PollMaxSeconds=60
AJ_Uva__SubmitMinIntervalSeconds=5
AJ_Uva__PendingTimeoutSeconds=900
AJ_Uva__MaxPending=20

# Must exceed AJ_Uva__PendingTimeoutSeconds, or the Server reclaims a job while
# this Runner is still waiting on the archive and the next Runner submits again.
AJ_Lease__RequestSeconds=1200
